# API server port
PORT=3001

# Frontend API base URL (baked into the browser bundle by Vite)
VITE_API_URL=http://localhost:3001

# Google OAuth Web Client ID (same value is used by the browser and API)
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Secret for signing session tokens — replace with a strong random value
JWT_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET

# Directory for the SQLite database and uploaded files
DATA_DIR=./server-data

# Optional folder containing an uncompressed eng.traineddata file for fully offline OCR setup
# TESSDATA_DIR=

# Optional server-side key for the separate AI Assistant only; document OCR does not use OpenAI
# OPENAI_API_KEY=
