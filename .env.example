# API server port
PORT=3001

# Frontend API base URL (baked into the browser bundle by Vite)
VITE_API_URL=http://localhost:3001

# Google OAuth Web Client ID (same value is used by the browser and API)
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Gmail API email delivery (server-side OAuth refresh token; never use VITE_ variables)
# Request https://www.googleapis.com/auth/gmail.send when issuing the refresh token.
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
# GMAIL_SENDER_EMAIL=

# Secret for signing session tokens — replace with a strong random value
JWT_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET

# Directory for the SQLite database and uploaded files
DATA_DIR=./server-data

# Optional folder containing an uncompressed eng.traineddata file for fully offline OCR setup
# TESSDATA_DIR=

# Optional server-side key for the separate AI Assistant only; document OCR does not use OpenAI
# OPENAI_API_KEY=

# ManageEngine Endpoint Central Cloud (India) OAuth integration
# Keep these server-side only; do not add them to VITE_* variables or commit real values.
# MANAGEENGINE_CLIENT_ID=
# MANAGEENGINE_CLIENT_SECRET=
# MANAGEENGINE_REFRESH_TOKEN=
# MANAGEENGINE_API_BASE_URL=https://endpointcentral.manageengine.in
# MANAGEENGINE_OAUTH_URL=https://accounts.zoho.in/oauth/v2/token
