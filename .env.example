# Supabase project URL — Settings > API > Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon public key — Settings > API > anon public
VITE_SUPABASE_ANON_KEY=

# Server-side secret for the process-invoice edge function.
# Set it in Supabase > Functions > process-invoice > Secrets (never in the browser bundle).
# OPENAI_API_KEY=
